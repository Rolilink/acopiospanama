# Variables de producción (en Coolify: Environment Variables del recurso). Nunca las subas a git.

# URL pública exacta, con https://
APP_ORIGIN=https://acopiopanama.org

# Genera cada secreto con: openssl rand -base64 48
POSTGRES_PASSWORD=
SECRET_KEY=

# Correo saliente (códigos de acceso, recordatorios). Ej.: smtps://usuario:clave@smtp.proveedor.com:465
SMTP_URL=
MAIL_FROM=Acopio Panamá <no-responder@acopiopanama.org>

# Respaldos cifrados: genera el par EN TU COMPUTADORA con `age-keygen -o acopio-respaldos.key`
BACKUP_AGE_RECIPIENT=

# Opcionales
# GHCR_OWNER=demogar            # dueño de las imágenes en ghcr.io
# IMAGE_TAG=latest              # o un sha concreto para fijar versión
# MAP_TILE_HOST=https://tile.openstreetmap.org   # cambia a un proveedor propio si hay mucho tráfico
# TRUST_PROXY=1                 # no lo subas salvo que añadas otro proxy delante
